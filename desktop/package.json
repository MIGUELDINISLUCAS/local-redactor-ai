{
  "name": "local-redactor-desktop",
  "version": "0.1.5",
  "private": true,
  "description": "Local Redactor AI — tray app that runs the backend engine",
  "main": "main.cjs",
  "scripts": {
    "electron": "electron .",
    "dev": "electron .",
    "build": "npm run build --prefix ../backend && electron-builder",
    "pack": "npm run build --prefix ../backend && electron-builder --dir"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "overrides": {
    "isbinaryfile": "^6.0.0"
  },
  "build": {
    "appId": "ai.localredactor.app",
    "productName": "Local Redactor AI",
    "publish": {
      "provider": "github",
      "owner": "MIGUELDINISLUCAS",
      "repo": "local-redactor-ai"
    },
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "preload.cjs"
    ],
    "extraResources": [
      { "from": "../backend/dist", "to": "backend" },
      {
        "from": "../backend/node_modules",
        "to": "backend/node_modules",
        "comment": "Ship exactly ONE onnxruntime. @xenova/transformers pulls in its own onnxruntime-node@1.14 alongside the 1.27 GLiNER uses, and both install a file named onnxruntime.dll. Windows resolves loaded DLLs by NAME, so whichever loads second matched its imports against the wrong version and failed with ERROR_INVALID_ORDINAL ('The operating system cannot run %1'), leaving Windows users on regex-only detection. macOS is unaffected because its libraries are versioned (libonnxruntime.1.27.0.dylib). The nested copy is an optionalDependency and we never run inference through transformers — only its tokenizer — so dropping it is safe.",
        "filter": ["**/*", "!@xenova/transformers/node_modules/onnxruntime-node/**"]
      },
      { "from": "../backend/package.json", "to": "backend/package.json" },
      { "from": "build/trayTemplate.png", "to": "trayTemplate.png" },
      { "from": "build/icon.ico", "to": "icon.ico" },
      { "from": "../backend/models/gliner-pii-large", "to": "models/gliner-pii-large" }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        { "target": "dmg", "arch": ["arm64"] },
        { "target": "zip", "arch": ["arm64"] }
      ],
      "hardenedRuntime": true,
      "identity": "Miguel Lucas (6X238J3VPJ)",
      "extendInfo": { "LSUIElement": true },
      "notarize": { "teamId": "6X238J3VPJ" }
    },
    "dmg": {
      "artifactName": "${productName}-${arch}.${ext}"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [{ "target": "nsis", "arch": ["x64"] }]
    },
    "nsis": {
      "artifactName": "${productName}-Setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Utility"
    }
  }
}
